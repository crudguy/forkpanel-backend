# ── Rust 构建产物 ──
/target
**/*.rs.bk
Cargo.lock.bak

# ── 内嵌前端产物（由前端仓库构建后提供，运行期内嵌不入库）──
crates/panel-cli/embed/assets/
web-dist/
web/dist/

# ── 本地运行数据（绝不入库）──
*.db
*.db-wal
*.db-shm
/var/
/data/
*.bak

# ── 密钥与证书 ──
master.key
*.pem
*.key
tls/

# ── 编辑器 / OS 噪声 ──
.idea/
.vscode/
*.swp
.DS_Store

# ── CI 运行缓存 ──
ci/.cache/

# 会话临时文件（AI 调试脚本等），不入库
.workbuddy/

# 本地 dev 运行日志（运行期产生，不入库）
.dev-backend.log

# 部署打包产物（build output，不入库）
# ⚠ build-static.sh 的 `OUT="dist"` 是**仓库根下的 dist/**，不是 deploy/dist/
#   （deploy/dist 是更早的输出位置，现已废弃）。两条都要留：
#   此前只写了 /deploy/dist/，于是 `git status` 一直显示 `?? dist/`，
#   一次 `git add -A` 就会把 5.8MB 的二进制包提交进仓库。
/dist/
/deploy/dist/
